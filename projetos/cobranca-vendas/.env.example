# Copie pra .env.local e preencha (esse arquivo de exemplo NÃO deve ter valores reais)

# Sem essas duas, o app funciona 100% local — só não sincroniza entre aparelhos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Senha simples que todo funcionário digita pra entrar no app (login único compartilhado).
# Deixe em branco pra não pedir senha nenhuma.
VITE_APP_PIN=
